      "parameters": {
        "jsCode": "const fs = require('fs');\nconst promptBase = '/workspace/groupscout/docs/mvps/mvp-c/prompts';\nconst readPrompt = (name) => fs.readFileSync(`${promptBase}/${name}`, 'utf8').trim();\nconst inputData = $node['Webhook'].json;\nreturn [{\n  json: {\n    ...inputData,\n    prompts: {\n      system_brand_voice: readPrompt('system_brand_voice.txt'),\n      user_milestone: readPrompt('user_milestone.txt'),\n      user_podcast: readPrompt('user_podcast.txt'),\n      user_slack_notify: readPrompt('user_slack_notify.txt')\n    }\n  }\n}];"
      },
