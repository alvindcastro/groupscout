        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 256,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($node['Load Prompts'].json.prompts.user_slack_notify.replace('{post_context_json}', JSON.stringify({ content_type: $json.content_type, about: $json.about, post_preview: $json.post_preview }))) }}\n    }\n  ]\n}",
        "options": {}
