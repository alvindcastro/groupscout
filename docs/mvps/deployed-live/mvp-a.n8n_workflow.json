    {
      "parameters": {
        "jsCode": "// Build notification_context_json and detect client action items\nconst data = $input.first().json.body || $input.first().json;\nconst openItems = data.open_items || [];\n\nconst clientKeywords = ['client', 'owner', 'select', 'confirm', 'approve', 'decide', 'choose'];\nconst hasClientItems = openItems.some(item =>\n  clientKeywords.some(kw => item.toLowerCase().includes(kw))\n);\n\nreturn {\n  project_json: JSON.stringify(data),\n  notification_context_json: JSON.stringify({\n    project_name: data.project_name,\n    client_name: data.client_name,\n    phase: data.phase,\n    next_site_visit: data.next_site_visit,\n    has_client_action_items: hasClientItems\n  })\n};"
      },
      "id": "28c3c435-eff9-45ca-a996-dc51411f267c",
