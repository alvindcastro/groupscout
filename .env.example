# GroupScout .env example
#
# The live values are SOPS-encrypted in deploy/secrets/prod.sops.env:
# `make secrets-render` writes .env from it and `make secrets-edit` changes it
# (needs the age key; see groupscout-site backend/docs/guides/SECRETS.md).
# Copy this template only for a fresh dev setup without that key.

# Container stack (docker-compose.yml)
# Optional Compose profiles for plain `docker compose` / `podman compose up`
# (llm = Ollama, obs = Prometheus/Grafana/Loki). `make docker-up` defaults to llm,obs.
COMPOSE_PROFILES=llm,obs
# Blank uses dev defaults locally; deploy/compose/compose.prod.yml requires all three.
# Rotating them on an existing stack needs more than an edit here; see SECRETS.md.
# POSTGRES_PASSWORD is embedded in DATABASE_URL, so use a URL-safe value (openssl rand -hex 24).
# It only applies when the pgdata volume is first created.
POSTGRES_PASSWORD=
# Must match the key n8n already stored in n8n_data or n8n refuses to start. Read it with:
#   docker compose exec n8n cat /home/node/.n8n/config
N8N_ENCRYPTION_KEY=
# Only applies when the grafana_data volume is first created.
GRAFANA_ADMIN_PASSWORD=
# Production image, set by the deploy job (local builds use groupscout:local)
# GROUPSCOUT_IMAGE=ghcr.io/alvindcastro/groupscout
# GROUPSCOUT_IMAGE_TAG=<git sha>

# Database
DATABASE_URL=postgres://groupscout:groupscout@localhost:5432/groupscout
# DATABASE_URL=groupscout.db

# API Keys
CLAUDE_API_KEY=your_anthropic_key_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
RESEND_API_KEY=re_your_resend_key_here
API_TOKEN=your_secure_bearer_token

# Email delivery (mirrors what is posted to Slack, including a no-lead notice)
# Comma-separated recipients, in delivery order (first address is the primary To).
LEAD_NOTIFY_EMAILS=sales@example.com,you@example.com
# From address; its domain must be verified in Resend.
EMAIL_FROM=GroupScout <alerts@groupscout.ai>

# Permit URLs
RICHMOND_PERMITS_URL=https://www.richmond.ca/shared/assets/Building_Permits5342.pdf
DELTA_PERMITS_URL=https://delta.ca/building-permits

# Toggles
CREATIVEBC_ENABLED=true
CREATIVEBC_URL=https://creativebc.my.salesforce-sites.com/inproduction
VCC_ENABLED=true
VCC_URL=https://www.vancouverconventioncentre.com/events/calendar
BCBID_ENABLED=true
NEWS_ENABLED=true
ANNOUNCEMENTS_ENABLED=true
EVENTBRITE_ENABLED=true

# Thresholds
ENRICHMENT_THRESHOLD=1
PRIORITY_ALERT_THRESHOLD=9
MIN_PERMIT_VALUE_CAD=500000

# Aviation & Weather (alertd)
SLACK_BOT_TOKEN=xoxb-your-bot-token
ECCC_ALERTS_URL=https://api.weather.gc.ca/collections/alerts/items
YVR_FLIGHT_STATUS_URL=https://www.yvr.ca/en/passengers/flights
NAVCANADA_NOTAM_URL=https://www.navcanada.ca/en/flight-planning/notam-portal.aspx
ALERTD_PORT=8081

# Planned Integrations
HUNTER_API_KEY=your_hunter_key_here

# AI providers for enrichment (internal/llm), tried in order. When one fails
# (no credit, bad key, outage) the next one scores the lead. A provider
# without a key is left out. Names: claude, openai, gemini, ollama, custom.
LLM_PROVIDERS=claude,openai,gemini
# CLAUDE_API_KEY is under API Keys above.
# CLAUDE_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Only for reasoning models (for example a gpt-5 model): minimal, low, medium or high.
# OPENAI_REASONING_EFFORT=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# "ollama" uses OLLAMA_ENDPOINT and OLLAMA_MODEL below.
# "custom" is any other OpenAI-format endpoint: LM Studio, llama.cpp, vLLM,
# LiteLLM, OpenRouter, Groq, Azure OpenAI.
# CUSTOM_LLM_BASE_URL=http://host.containers.internal:1234/v1
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_MODEL=
# CUSTOM_LLM_JSON_MODE=true
# Per-call timeouts in seconds: cloud providers, then ollama/custom.
# LLM_TIMEOUT_S=60
# LLM_LOCAL_TIMEOUT_S=180

# Ollama / Local LLM
OLLAMA_ENABLED=true
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=mistral

# Feature Toggles (Ollama)
OLLAMA_EXTRACTION_ENABLED=true
OLLAMA_SCORING_ENABLED=true
OLLAMA_ALERT_COPY_ENABLED=true

# Ollama Timeouts (seconds)
OLLAMA_EXTRACT_TIMEOUT_S=30
OLLAMA_SCORE_TIMEOUT_S=20
OLLAMA_ALERT_COPY_TIMEOUT_S=15

# Server
PORT=8080
DIGEST_DAYS=monday,wednesday
DIGEST_HOUR=9

# Raw audit retention
# When enabled, server mode purges unreferenced raw_inputs older than the retention window.
AUDIT_RETENTION_ENABLED=false
AUDIT_RETENTION_DAYS=30
AUDIT_RETENTION_INTERVAL_HOURS=24
AUDIT_RETENTION_RUN_ON_START=true
